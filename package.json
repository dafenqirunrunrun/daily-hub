{
  "name": "daily-hub",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first personal Daily Hub desktop app.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 32123\" \"tsc -p tsconfig.node.json && npm run rebuild:native && wait-on http://127.0.0.1:32123/ && electron .\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.node.json",
    "pack": "npm run build && npm run rebuild:native && electron-builder --dir",
    "dist": "npm run build && npm run rebuild:native && electron-builder --win nsis",
    "lint": "eslint .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -b",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:e2e": "npm run pack && playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "build": {
    "appId": "com.local.dailyhub",
    "productName": "Daily Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "24.13.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
